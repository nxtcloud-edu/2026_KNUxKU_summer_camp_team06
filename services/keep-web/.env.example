# Copy this file to .env, then set the local Gemini API key.
GEMINI_API_KEY=
# Example: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Supabase project values. Keep every value in server-side .env only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Never expose this value to the Extension, Web, or GitHub.
SUPABASE_SERVICE_ROLE_KEY=
